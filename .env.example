# SentinelAI Full-Stack Environment Template
# Copy this file to src/backend/.env and src/frontend/.env as instructed in docs/setup-guide.md

# ==============================================================================
# BACKEND CONFIGURATION (src/backend/.env)
# ==============================================================================
APP_NAME=SentinelAI
APP_ENV=development
DEBUG=True
PORT=8000

# Managed PostgreSQL (Neon Cloud Database Recommended)
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require

# Individual DB fields (used if DATABASE_URL is not set)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=SentinelAI
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Frontend & CORS Settings
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://sentinel-ai-ibm-bob.vercel.app
CORS_ORIGIN_REGEX=https://.*\.(vercel\.app|onrender\.com|netlify\.app|pages\.dev)
API_PREFIX=/api/v1

# Security & Authentication (Single Administrator)
# Pre-configured Administrator credentials: sentinelai712@gmail.com / Admin@712
ADMIN_EMAIL=sentinelai712@gmail.com
ADMIN_PASSWORD_HASH=$2b$12$A0XvgK4RCBVt.FxxPWoSxenOJ2GbEGAwOtJ7pc1pII0AODD4d84KW
SESSION_COOKIE_NAME=sentinel_session
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=lax
SESSION_EXPIRE_MINUTES=1440
JWT_SECRET_KEY=sentinel_ai_dev_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Copilot Inference (Groq - High Speed Cloud LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=15

# IBM Bob API (Fallback Cloud LLM)
IBM_BOB_API_KEY=your_ibm_bob_api_key_here
IBM_BOB_API_URL=https://api.us-east.bob.ibm.com/inference/v1/chat/completions
IBM_BOB_MODEL=ibm/granite-3-8b-instruct

# ==============================================================================
# FRONTEND CONFIGURATION (src/frontend/.env)
# ==============================================================================
# For Local Development:
VITE_API_BASE_URL=http://localhost:8000
# For Production (Cloud Deployed):
# VITE_API_BASE_URL=https://bob-ai-hackathon-nexgen.onrender.com

VITE_APP_TITLE=SentinelAI
VITE_APP_ENV=development
