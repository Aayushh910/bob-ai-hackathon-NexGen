# SentinelAI Backend Production Environment Variables
APP_NAME=SentinelAI
APP_ENV=production
DEBUG=False
PORT=8000

# Neon PostgreSQL Managed Database (Required for Production)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Production Frontend URLs & CORS
FRONTEND_URL=https://sentinel-ai-ibm-bob.vercel.app
CORS_ORIGINS=https://sentinel-ai-ibm-bob.vercel.app,http://localhost:5173,http://localhost:3000
CORS_ORIGIN_REGEX=https://.*\.(vercel\.app|onrender\.com|netlify\.app|pages\.dev)

# Cryptographic Secret Key (Generate a random 64-char string for production)
JWT_SECRET_KEY=generate_strong_random_secret_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Single Administrator Production Credentials
# Pre-configured credentials: sentinelai712@gmail.com / Admin@712
ADMIN_EMAIL=sentinelai712@gmail.com
ADMIN_PASSWORD_HASH=$2b$12$A0XvgK4RCBVt.FxxPWoSxenOJ2GbEGAwOtJ7pc1pII0AODD4d84KW
SESSION_COOKIE_NAME=sentinel_session
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=none
SESSION_EXPIRE_MINUTES=1440

# AI Copilot Inference (Groq - High Speed Cloud LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=15

# IBM Bob API (Fallback Cloud LLM)
IBM_BOB_API_KEY=your_ibm_bob_api_key_here
IBM_BOB_API_URL=https://api.us-east.bob.ibm.com/inference/v1/chat/completions
IBM_BOB_MODEL=ibm/granite-3-8b-instruct
