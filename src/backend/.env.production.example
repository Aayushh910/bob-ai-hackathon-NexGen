# SentinelAI Backend Production Environment Variables
APP_NAME=SentinelAI
APP_ENV=production
DEBUG=False
PORT=8000

# Neon PostgreSQL Managed Database (Required for Production)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Production Frontend URLs (Vercel / Render / Custom Domain)
FRONTEND_URL=https://sentinel-ai-ibm-bob.vercel.app
CORS_ORIGINS=https://sentinel-ai-ibm-bob.vercel.app,http://localhost:5173
CORS_ORIGIN_REGEX=https://.*\.(vercel\.app|onrender\.com|netlify\.app|pages\.dev)

# Cryptographic Secret Key (Generate a random 64-char string for production)
JWT_SECRET_KEY=generate_strong_random_secret_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
